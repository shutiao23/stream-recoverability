<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f1" name="Screening system architecture">
    <mxGraphModel dx="1180" dy="820" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="vis" value="Visible at decision time" style="rounded=1;fillColor=none;strokeColor=#90A4AE;dashed=1;fontSize=12;fontStyle=1;fontColor=#455A64;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="410" height="318" as="geometry"/>
        </mxCell>
        <mxCell id="f1a" value="Outage geometry&#10;longest run, total missing, number of runs" style="rounded=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="58" y="96" width="374" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="f1b" value="Support of the estimand&#10;peak-window overlap, warm-season observed fraction" style="rounded=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="58" y="150" width="374" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="f1c" value="Constraint already imposed by the observed days&#10;observed-peak margin, which flanks survived" style="rounded=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="58" y="204" width="374" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="f1d" value="Donor information&#10;count, coverage, training-period deseasonalised correlation" style="rounded=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="58" y="258" width="374" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="f1e" value="Station history&#10;record length, training residual scale, seasonal amplitude" style="rounded=0;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="58" y="312" width="374" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="bar" value="Information barrier&#10;No feature may read a day the outage hides.&#10;Enforced in feature_frame; pinned by a test in the suite." style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11.5;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="410" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="est" value="Estimator library &#8212; support declared per case&#10;observed days (current practice)  &#183;  day-of-year climatology&#10;smoothed climatology  &#183;  linear interpolation (both flanks required)&#10;donor ridge (refit on visible donors)  &#183;  air ridge (where forcing exists)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="440" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="risk" value="Risk model&#10;predicted upper bound on | q(&#375;) &#8722; q(y) | for each supported estimator" style="rounded=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11.5;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="500" y="188" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sel" value="Estimator selection &#8212; take the smallest bound" style="rounded=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=11.5;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="500" y="284" width="440" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="cal" value="Split-conformal calibration&#10;selection-conditional &#8212; calibrated after the estimator is chosen, because&#10;taking the smallest of several bounds is a winner&#8217;s curse that per-estimator&#10;calibration cannot see&#10;multiplicative &#8212; the error scale spans an order of magnitude" style="rounded=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="500" y="360" width="440" height="104" as="geometry"/>
        </mxCell>

        <mxCell id="cert" value="Calibrated certificate for this station-year&#10;an interval on the completed-year statistic, in &#176;C, and a risk score" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="500" y="496" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="act1" value="Action space 1 &#8212; admission&#10;retain or exclude the station-year at a tolerance &#964; stated in &#176;C.&#10;Decides what enters the archive.&#10;Reserved panel at 70% retention: 2.5% against 9.7% for the length rule." style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="180" y="606" width="450" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="Action space 2 &#8212; abstention&#10;keep every year and decline only the judgement the interval cannot support.&#10;Decides what one judgement may say.&#10;Judges 92.7% of years at 0.42% misclassification against 67.5% at 0.36%." style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="680" y="606" width="450" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="Fitted leave-one-year-out&#10;within the station.&#10;&#167;5.10 repeats the study&#10;under strictly-prior-years&#10;fitting." style="shape=note;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10.5;fontColor=#795548;align=left" vertex="1" parent="1">
          <mxGeometry x="975" y="60" width="180" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Absent donor columns are&#10;never imputed; the model is&#10;refit on the visible subset." style="shape=note;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10.5;fontColor=#795548;align=left" vertex="1" parent="1">
          <mxGeometry x="975" y="188" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="Fitting, calibration and&#10;test networks are always&#10;disjoint. Every interval&#10;resamples whole networks." style="shape=note;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10.5;fontColor=#795548;align=left" vertex="1" parent="1">
          <mxGeometry x="975" y="368" width="180" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="vis" target="est">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="106"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="vis" target="risk">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="218"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed3" value="enforced on every feature" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C62828;dashed=1;fontColor=#B71C1C;fontSize=10" edge="1" parent="1" source="bar" target="vis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed4" value="completed-year statistic per estimator" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="est" target="risk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="risk" target="sel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="sel" target="cal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F" edge="1" parent="1" source="cal" target="cert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32" edge="1" parent="1" source="cert" target="act1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="580"/><mxPoint x="405" y="580"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32" edge="1" parent="1" source="cert" target="act2">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="580"/><mxPoint x="905" y="580"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed10" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#B0BEC5;dashed=1;endArrow=none" edge="1" parent="1" source="n1" target="est"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed11" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#B0BEC5;dashed=1;endArrow=none" edge="1" parent="1" source="n2" target="est"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#B0BEC5;dashed=1;endArrow=none" edge="1" parent="1" source="n3" target="cal"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
