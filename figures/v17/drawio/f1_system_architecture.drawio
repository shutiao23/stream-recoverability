<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f1" name="Screening system architecture">
    <mxGraphModel dx="988" dy="808" grid="1" gridSize="10" page="1" pageWidth="988" pageHeight="808" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="vis" value="&lt;b&gt;Visible at decision time&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=15;fontColor=#37474F;dashed=1;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="430" height="336" as="geometry"/>
        </mxCell>
        <mxCell id="f1a" value="&lt;b&gt;Outage geometry&lt;/b&gt;&#10;longest run, total missing, number of runs" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="36" y="62" width="398" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="f1b" value="&lt;b&gt;Support of the estimand&lt;/b&gt;&#10;peak-window overlap, warm-season share" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="398" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="f1c" value="&lt;b&gt;Constraint from the observed days&lt;/b&gt;&#10;observed-peak margin, which flanks survived" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="36" y="170" width="398" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="f1d" value="&lt;b&gt;Donor information&lt;/b&gt;&#10;count, coverage, deseasonalised correlation" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="36" y="224" width="398" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="f1e" value="&lt;b&gt;Station history&lt;/b&gt;&#10;record length, residual scale, amplitude" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=14;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="36" y="278" width="398" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="bar" value="&lt;b&gt;Information barrier&lt;/b&gt;&#10;no feature may read a day the outage hides;&#10;enforced in the feature constructor and by a test" style="rounded=1;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=14;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="20" y="396" width="430" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="est" value="&lt;b&gt;Estimator library — support declared per case&lt;/b&gt;&#10;observed days (current practice) · day-of-year climatology&#10;smoothed climatology · linear interpolation (both flanks&#10;required) · donor ridge (refit on visible donors) ·&#10;air ridge (where forcing exists)" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="490" y="20" width="470" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="risk" value="&lt;b&gt;Risk model&lt;/b&gt;&#10;predicted upper bound on | q(ŷ) − q(y) |&#10;for each supported estimator" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="490" y="170" width="470" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sel" value="&lt;b&gt;Estimator selection — take the smallest bound&lt;/b&gt;" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="490" y="260" width="470" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="cal" value="&lt;b&gt;Split-conformal calibration&lt;/b&gt;&#10;selection-conditional: calibrated after the estimator&#10;is chosen, because taking the smallest of several&#10;bounds is a winner's curse that per-estimator&#10;calibration cannot see; multiplicative, because the&#10;error scale spans an order of magnitude" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="490" y="328" width="470" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="cert" value="&lt;b&gt;Calibrated certificate for this station-year&lt;/b&gt;&#10;an interval on the completed-year statistic, in °C,&#10;and a risk score" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="490" y="468" width="470" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="&lt;b&gt;Action space 1 — admission&lt;/b&gt;&#10;retain or exclude the year at a tolerance τ in °C;&#10;decides what enters the archive. Reserved panel at&#10;70% retention: 2.5% against 9.7% for the length rule." style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="430" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="&lt;b&gt;Action space 2 — abstention&lt;/b&gt;&#10;keep every year and abstain only where the interval&#10;straddles the threshold; decides what one judgement may&#10;say. Judges 92.7% of years at 0.42% misclassification,&#10;against 67.5% at 0.36% for screening at 0.5 °C." style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="490" y="560" width="470" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Notes on fitting and evaluation&lt;/b&gt;&#10;Fitted leave-one-year-out within the station; a prior-years-only refit is reported as a sensitivity.&#10;Absent donor columns are never imputed; the model is refit on the visible subset. Fitting, calibration&#10;and test networks are always disjoint, and every interval resamples whole networks." style="rounded=1;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=14;fontColor=#795548" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="940" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="enforced on every feature" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C62828;fontSize=14;fontColor=#B71C1C;dashed=1" edge="1" parent="1" source="bar" target="vis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="vis" target="est">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="178"/><mxPoint x="470" y="90"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="vis" target="risk">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="250"/><mxPoint x="470" y="208"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="d4" value="completed-year statistic" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="est" target="risk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="risk" target="sel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d6" value="selection-conditional" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="sel" target="cal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="cal" target="cert">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d8" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;fontSize=14" edge="1" parent="1" source="cert" target="act1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="550"/><mxPoint x="235" y="550"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="d9" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;fontSize=14" edge="1" parent="1" source="cert" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
