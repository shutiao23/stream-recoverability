<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f3" name="Evidence chain and closure">
    <mxGraphModel dx="963" dy="1002" grid="1" gridSize="10" page="1" pageWidth="963" pageHeight="1002" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c1" value="&lt;b&gt;Real archive — sample fact&lt;/b&gt;&#10;nine agencies, 146 networks, 457 stations, 5,114 fully observed station-years" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Designed outages — sample fact&lt;/b&gt;&#10;51,524 cases on an empirical and a stratified arm; 40,704 development, 10,820 reserved" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="122" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Q1 · which property of a gap governs the error? — sample fact&lt;/b&gt;&#10;an annual mean grows 10.2× along missing days and 1.5× along peak-window overlap;&#10;the hottest 30-day mean reverses both (3.5× and 9.6×)" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=15;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="20" y="224" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Q2 · two regimes or a continuum? — exploratory post-open&lt;/b&gt;&#10;the crossing is an interval, 77 to 107 days; the 90-day point is indistinguishable from zero&#10;the conditioning set is the support dilated by about two location SDs (60 to 90 days)" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=15;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="20" y="326" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Q3 · what does conditioning change? — retrospective holdout&lt;/b&gt;&#10;36 reserved networks opened once: 9.7% → 2.5% at 70% retention, −7.13 points&#10;[−8.97, −5.36]; the empirical arm is unresolved" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="428" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Sealed confirmation, USGS — sealed confirmation&lt;/b&gt;&#10;39 HUC4 networks, 8,973 cases, scored once: −7.9 points [−10.2, −5.8];&#10;the 15 outcome-clean networks give −9.4 points [−12.4, −6.0]" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="530" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Multi-agency transport — sealed confirmation&lt;/b&gt;&#10;32 pre-registered primary networks: −4.6 points [−6.5, −3.3]; quality-checked&#10;stratum −6.2 [−8.4, −4.5]; NVE secondary stratum, 21 networks, −6.1 [−8.7, −4.6]" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="632" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Truth-free deployment — sample fact, no truth read&lt;/b&gt;&#10;2,422 real incomplete station-years: the two admission rules disagree on 15.1%;&#10;wholly hidden climatological peak windows are a proxy (PPV 0.74)" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="734" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Consequence — sample fact&lt;/b&gt;&#10;admitting incomplete years raises the archive mean by about 0.5 °C and the four&#10;rules differ by less than 0.1 °C; at the 140-day limit 17 admitted years hide the peak window" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="836" width="900" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="cap" value="&lt;b&gt;Pooled designed outages close the loop; the empirical arm stays open.&lt;/b&gt;" style="html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="944" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry"/>
