<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f2" name="Study design and data flow">
    <mxGraphModel dx="968" dy="920" grid="1" gridSize="10" page="1" pageWidth="968" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="L1" value="&lt;b&gt;Nine national providers&lt;/b&gt;&#10;ARSO · CHMI · FOEN · GKD Bayern ·&#10;LUBW · NVE · Rijkswaterstaat · SYKE · USGS" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="450" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;River-only, complete-year filter&lt;/b&gt;&#10;lakes, seas, canals, estuaries, deltas out&#10;a year with any missing day: no truth&#10;fewer than four complete years: out&#10;146 networks · 457 stations ·&#10;5,114 completely observed station-years" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="430" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;Split at the network level&lt;/b&gt;&#10;never at the station-year level;&#10;stratified on provider × donor regime&#10;110 development · 36 reserved" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=15;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="20" y="178" width="450" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;Reserved panel: retrospective holdout&lt;/b&gt;&#10;28 of 36 networks have earlier&#10;programme use; not an unused&#10;confirmation set for new analyses" style="rounded=1;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=15;fontColor=#37474F" vertex="1" parent="1">
          <mxGeometry x="510" y="178" width="430" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;Outages designed, configuration frozen&lt;/b&gt;&#10;51,524 cases; empirical and stratified arms&#10;40,704 development · 10,820 reserved&#10;declared before the reserved panel opened&#10;matched retention; at least five points;&#10;a network-clustered interval excluding zero" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14.5;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="304" width="450" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;Reserved panel opened once&lt;/b&gt;&#10;9.7% → 2.5% at 70% retention&#10;−7.13 points [−8.97, −5.36]&#10;the empirical arm is unresolved" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="510" y="304" width="430" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;Sealed USGS confirmation&lt;/b&gt;&#10;39 HUC4 networks · 91 stations ·&#10;8,973 designed cases, outside the&#10;development programme; scored once&#10;−7.9 points [−10.2, −5.8]" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="462" width="450" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;Prior-access audit and clean subset&lt;/b&gt;&#10;24 of 39 networks appear in earlier work&#10;15 outcome-clean networks: −9.4 points&#10;[−12.4, −6.0]; a transparency diagnostic,&#10;not new confirmation" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="510" y="462" width="430" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="L5" value="&lt;b&gt;Pre-registered transport panel&lt;/b&gt;&#10;SMHI · UK EA · Hub'Eau: 32 primary&#10;networks across three contexts,&#10;four assurance strata combinations,&#10;sealed and scored once: −4.6 points&#10;[−6.5, −3.3]" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="622" width="450" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="R5" value="&lt;b&gt;Primary and secondary strata&lt;/b&gt;&#10;quality-checked stratum: −6.2 points&#10;[−8.4, −4.5], agreeing with the pooled&#10;verdict; NVE secondary stratum,&#10;21 networks: −6.1 points [−8.7, −4.6]" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="510" y="622" width="430" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="L6" value="&lt;b&gt;Truth-free deployment&lt;/b&gt;&#10;2,422 real incomplete station-years,&#10;which carry no truth; the frozen&#10;screen is applied to them unchanged" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="450" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="R6" value="&lt;b&gt;Two admission rules compared&lt;/b&gt;&#10;length rule vs peak-window screening&#10;disagree on 15.1% of the 2,422 years;&#10;the certificate instead supports abstention&#10;where the interval straddles the threshold" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=15;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="510" y="780" width="430" height="112" as="geometry"/>
        </mxCell>

