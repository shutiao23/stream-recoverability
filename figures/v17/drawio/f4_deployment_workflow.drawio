<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f4" name="Agency deployment workflow">
    <mxGraphModel dx="988" dy="872" grid="1" gridSize="10" page="1" pageWidth="988" pageHeight="872" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n0" value="&lt;b&gt;A station-year with an outage reaches the archive&lt;/b&gt;" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="540" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="&lt;b&gt;Which statistic will be computed?&lt;/b&gt;" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=15;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="20" y="92" width="540" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;A warm-season extreme&lt;/b&gt;&#10;hottest 7-day or 30-day mean" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="164" width="540" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Locate the climatological peak window&lt;/b&gt;&#10;from the station's own complete years;&#10;no data beyond its own record is needed" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14.5;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="244" width="540" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Three numbers from the outage mask alone&lt;/b&gt;&#10;peak_overlap · warm_observed_fraction ·&#10;longest_run_days" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14.5;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="344" width="540" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;risk = logistic(−1.302 + 2.070 · peak_overlap&lt;/b&gt;&#10;&lt;b&gt;− 2.412 · warm_observed_fraction&lt;/b&gt;&#10;&lt;b&gt;− 0.00187 · longest_run_days)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="444" width="540" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;Rank by risk and admit to the retention&lt;/b&gt;&#10;the monitoring programme can afford" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=15;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="544" width="540" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Guardrail: check what the rule keeps&lt;/b&gt;&#10;retention by elevation, slope, donor availability;&#10;if the archived set is not representative, apply&#10;the threshold within stratum (about 0.3 points)" style="rounded=1;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=14.5;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="20" y="628" width="540" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;What the substitution buys, at 70% retention&lt;/b&gt;&#10;on the retrospective 36-network holdout:&#10;9.7% → 2.5% for the calibrated screen;&#10;the three-variable rule gives 4.2%" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14.5;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="748" width="540" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="ba" value="&lt;b&gt;An average or sine-fit parameter&lt;/b&gt;&#10;annual mean, coldest 30-day mean,&#10;sine-fit mean, phase, amplitude" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="600" y="92" width="360" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="ba2" value="&lt;b&gt;Keep the length-based rule&lt;/b&gt;&#10;threshold the number of missing days;&#10;length is the better axis here&#10;(annual mean AUC 0.845 against 0.672)" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="600" y="190" width="360" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;For an uncertainty statement in °C&lt;/b&gt;&#10;run the calibrated screen and report&#10;its interval. A pooled interval speaks&#10;for a population of networks, not for&#10;one site; cluster calibration stays&#10;exploratory until it is validated&#10;outside the development programme." style="rounded=1;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=14;fontColor=#795548" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="360" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;For a single threshold judgement&lt;/b&gt;&#10;do not discard the year: abstaining&#10;where the interval straddles the&#10;threshold judges 92.7% of years at&#10;0.42%, against 67.5% at 0.36% for&#10;screening at the same tolerance." style="rounded=1;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=14;fontColor=#795548" vertex="1" parent="1">
          <mxGeometry x="600" y="494" width="360" height="124" as="geometry"/>
        </mxCell>

        <mxCell id="y1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;fontSize=14" edge="1" parent="1" source="n0" target="q1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
