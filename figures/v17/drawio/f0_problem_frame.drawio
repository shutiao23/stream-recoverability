        <mxCell id="ma" value="Measured on 40,704 development cases&#10;error grows 10.2&#215; along missing days&#10;and 1.5&#215; along peak-window overlap" style="rounded=0;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11.5;fontColor=#1B5E20" vertex="1" parent="1">
