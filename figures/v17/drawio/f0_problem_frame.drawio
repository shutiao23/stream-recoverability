        <mxCell id="rec" value="A station-year  y = (y&#8321; … y_T),  T &#8712; {365, 366}&#10;with an outage mask  m &#8712; {0,1}^T ;  the analyst sees only the days where m&#8348; = 0" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;fontStyle=1;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="520" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="qa" value="Estimand A — annual mean&#10;q(y) = (1/T) &#931;&#8348; y&#8348;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=12.5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="290" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="qb" value="Estimand B — hottest 30-day mean&#10;q(y) = max&#8348; (1/30) &#931;&#7522;&#8330;&#8348; y&#7522;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=12.5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="730" y="140" width="290" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="sa" value="Support: all T days,&#10;each carrying weight 1/T" style="rounded=0;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="100" y="238" width="290" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="sb" value="Support: one 30-day window W_q,&#10;located by the station's own climatology" style="rounded=0;fillColor=#FFFFFF;strokeColor=#78909C;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="730" y="238" width="290" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="inc" value="Incumbent completeness rule&#10;s(m) = 1{ max run(m) &#8804; &#952; }&#10;&#10;Conditioning set: the size of the outage.&#10;Applied to every estimand alike." style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12.5;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="280" height="154" as="geometry"/>
