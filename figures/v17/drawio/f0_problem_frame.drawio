        <mxCell id="aa" value="Governing axis&#10;how many days are missing" style="rounded=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=12.5;fontStyle=1;fontColor=#E65100" vertex="1" parent="1">
