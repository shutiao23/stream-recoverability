<mxfile host="app.diagrams.net" agent="stream-recoverability" version="24.7.17">
  <diagram id="f0" name="Problem frame">
    <mxGraphModel dx="998" dy="642" grid="1" gridSize="10" page="1" pageWidth="998" pageHeight="642" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="rec" value="A station-year  y = (y₁ … y_T),  T ∈ {365, 366},  with an outage mask  m ∈ {0,1}^T&#10;the analyst sees only the days where m_t = 0" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="950" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="qa" value="&lt;b&gt;Estimand A — annual mean&lt;/b&gt;&#10;q(y) = (1/T) Σ_t y_t" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="20" y="126" width="300" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="qb" value="&lt;b&gt;Estimand B — hottest 30-day mean&lt;/b&gt;&#10;q(y) = max_t (1/30) Σ_{i=t..t+29} y_i" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=14;fontColor=#102027" vertex="1" parent="1">
          <mxGeometry x="640" y="126" width="330" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="inc" value="&lt;b&gt;Incumbent completeness rule&lt;/b&gt;&#10;s(m) = 1{ max run(m) ≤ θ }&#10;Conditioning set: the size of&#10;the outage. Applied to every&#10;estimand alike." style="rounded=1;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=15;fontColor=#B71C1C" vertex="1" parent="1">
          <mxGeometry x="330" y="126" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="sa" value="Support: all T days,&#10;each carrying weight 1/T" style="rounded=1;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=14;fontColor=#37474F" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="300" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="sb" value="Support: one 30-day window W_q,&#10;located by the station's own climatology" style="rounded=1;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=14;fontColor=#37474F" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="330" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="aa" value="&lt;b&gt;Governing axis&lt;/b&gt;&#10;how many days are missing" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="300" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="ab" value="&lt;b&gt;Governing axis&lt;/b&gt;&#10;how much of W_q is hidden" style="rounded=1;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=14;fontColor=#E65100" vertex="1" parent="1">
          <mxGeometry x="640" y="310" width="330" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="ma" value="Measured on 40,704 development cases&#10;error grows 10.2× along missing days&#10;and 1.5× along peak-window overlap" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="20" y="398" width="300" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="mb" value="Measured on the same cases&#10;error grows 3.5× along missing days&#10;and 9.6× along peak-window overlap" style="rounded=1;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=14;fontColor=#1B5E20" vertex="1" parent="1">
          <mxGeometry x="640" y="398" width="330" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="law" value="&lt;b&gt;One scale, not two regimes: measure missingness on the support of the estimand.&lt;/b&gt;&#10;‘Timing versus length’ is that scale at its two ends; the crossing is an interval, 77 to 107 days.&#10;The conditioning set is the support dilated by the wander of its own location:&#10;one agency window of 60 to 90 days serves every warm-season endpoint." style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=15;fontColor=#0D47A1" vertex="1" parent="1">
          <mxGeometry x="20" y="514" width="950" height="100" as="geometry"/>
        </mxCell>

